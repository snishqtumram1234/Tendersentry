# TenderSentry configuration. Copy to .env and fill in. Never commit .env.
# Database + storage are Supabase (docs/DECISIONS.md ADR-001). Values below target the Supabase CLI
# local stack (`supabase start`); run `supabase status` to print local keys.

APP_ENV=local                     # local | demo | staging | production
APP_BASE_URL=http://localhost:8080
API_PORT=4000
ENGINE_URL=http://engine:8000
ENGINE_TOKEN=change-me

# --- Supabase: Postgres ---
# Runtime (API/worker): restricted ts_app role. Hosted: Supavisor pooler, transaction mode (port 6543).
DATABASE_URL=postgresql://ts_app:ts_app_local_only@host.docker.internal:54322/postgres
# Migrations + seed: owner role over a direct/session connection.
DIRECT_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres
# Hosted example (region ap-south-1):
# DATABASE_URL=postgresql://ts_app.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&sslmode=require
# DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# --- Supabase project (server-side only; never exposed to apps/web) ---
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_SERVICE_ROLE_KEY=        # only for bucket bootstrap scripts; not used at runtime

# --- Supabase Storage via S3-compatible endpoint ---
STORAGE_ENDPOINT=http://host.docker.internal:54321/storage/v1/s3
STORAGE_REGION=local              # hosted: project region, e.g. ap-south-1
STORAGE_FORCE_PATH_STYLE=true
STORAGE_ACCESS_KEY=               # local: `supabase status` → S3 Access Key; hosted: Dashboard → Storage → S3 access keys
STORAGE_SECRET_KEY=
STORAGE_BUCKET_DOCUMENTS=documents
STORAGE_BUCKET_CAPTURES=captures
STORAGE_BUCKET_REPORTS=reports
STORAGE_BUCKET_PAGE_IMAGES=page-images
FILE_MAX_MB=25

REDIS_URL=redis://redis:6379
SESSION_JWT_SECRET=change-me-64-bytes-change-me-64-bytes-change-me-64-bytes-000000
SESSION_TTL_MINUTES=60
REFRESH_TTL_DAYS=7
APP_ENCRYPTION_KEY=               # 32 bytes base64 (AES-GCM for MFA secrets and provider credentials)

# Local: Supabase CLI bundles Mailpit (UI http://localhost:54324)
SMTP_HOST=host.docker.internal
SMTP_PORT=54325
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="TenderSentry <no-reply@tendersentry.local>"

MODEL_PROVIDER=anthropic          # anthropic | openai | none
MODEL_NAME=
MODEL_PROVIDER_KEY=
LLM_ALLOW_BIDDER_DOCS=false
OCR_LANGS=eng+hin
CLAMAV_HOST=

DEMO_MODE=true                    # local/demo only; forced false in production
DEMO_OTP=000000
SIMULATED_ADAPTER_ENABLED=false   # forced false in production

GST_PROVIDER_BASE_URL=
GST_PROVIDER_KEY=
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
FEATURE_RELATIONSHIP_GRAPH=false
FEATURE_TENDER_COPILOT=false
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
