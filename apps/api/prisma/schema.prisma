// TenderSentry data model (docs/BUILD_SPEC.md §7) on Supabase Postgres.
// Runtime connects as ts_app through the pooler (DATABASE_URL); migrations run as postgres (DIRECT_URL).
// Triggers, RLS lock-down and grants live in prisma/sql/ and are applied by hand-written migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

