model Notification {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String
  title     String
  body      String
  link      String?
  critical  Boolean   @default(false)
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  emailedAt DateTime? @map("emailed_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
  @@map("notifications")
}

model Job {
  id           String    @id @default(uuid(7)) @db.Uuid
  queue        String
  entityType   String?   @map("entity_type")
  entityId     String?   @map("entity_id")
  status       JobStatus @default(QUEUED)
  step         String?
  attempts     Int       @default(0)
  maxAttempts  Int       @default(3) @map("max_attempts")
  startedAt    DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt   DateTime? @map("finished_at") @db.Timestamptz(6)
  errorCode    String?   @map("error_code")
  errorMessage String?   @map("error_message")
  payloadHash  String?   @map("payload_hash")
  organisationId String? @map("organisation_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([queue, status])
  @@map("jobs")
}

model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(false)
  scope     String   @default("GLOBAL")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("feature_flags")
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid

  @@map("system_settings")
}

model Report {
  id               String       @id @default(uuid(7)) @db.Uuid
  type             ReportType
  entityId         String       @map("entity_id") @db.Uuid
  format           ReportFormat
  storageBucket    String?      @map("storage_bucket")
  storageKey       String?      @map("storage_key")
  sha256           String?
  jobId            String?      @map("job_id") @db.Uuid
  organisationId   String       @map("organisation_id") @db.Uuid
  generatedBy      String       @map("generated_by") @db.Uuid
  generatedAt      DateTime?    @map("generated_at") @db.Timestamptz(6)
  dataSnapshotHash String?      @map("data_snapshot_hash")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("reports")
}

model DemoRequest {
  id           String   @id @default(uuid(7)) @db.Uuid
  name         String
  email        String   @db.Citext
  organisation String?
  message      String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("demo_requests")
}
